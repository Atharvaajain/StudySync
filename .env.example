# StudySync server configuration. Copy to apps/server/.env for local development
# (the server loads that file at start-up; real environment variables win).
# NODE_ENV: development | test | production (production: see deploy/production.env.example)
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL 16 (scripts/dev-db.sh creates this role and database in the cloud container).
DATABASE_URL="postgresql://studysync:studysync@127.0.0.1:5432/studysync_dev?schema=public"

# Access-token signing secret (HS256): any random string of at least 32 characters.
# Never commit a real secret.
JWT_ACCESS_SECRET="dev-only-change-me-dev-only-change-me-0123456789"

# The dev server is plain http://127.0.0.1, so the refresh cookie cannot be `Secure` here.
# Leave it true (the default) anywhere HTTPS is used.
COOKIE_SECURE=false

# bcrypt cost (default 12; values below 10 are test-only).
# BCRYPT_COST=12

# Reverse proxies in front of the server (0 locally; see deploy/production.env.example).
TRUST_PROXY=0

# Serve a built web app from this directory (used by the E2E run). Leave empty in development.
STATIC_DIR=

# Test-only switches (NODE_ENV=test only): server clock control (POST /__test__/clock),
# relaxed auth rate limits, other token lifetimes.
ENABLE_TEST_CLOCK=false
# RELAX_RATE_LIMITS=false
# ACCESS_TOKEN_TTL_SEC=900
