# StudySync server — Phase 0 prototype configuration (all optional).
# NODE_ENV: development | test   (production is refused in Phase 0: there is no authentication yet)
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Serve a built web app from this directory (used by the E2E run). Leave empty in development.
STATIC_DIR=
# Test-only server clock control (POST /__test__/clock). Only allowed with NODE_ENV=test.
ENABLE_TEST_CLOCK=false
