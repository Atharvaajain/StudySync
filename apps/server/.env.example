# Copy to apps/server/.env for local development (`scripts/dev-db.sh` creates this database).
DATABASE_URL="postgresql://studysync:studysync@127.0.0.1:5432/studysync_dev?schema=public"
# Any random string of at least 32 characters. Never commit a real secret.
JWT_ACCESS_SECRET="dev-only-change-me-dev-only-change-me-0123456789"
# The dev server is plain http://127.0.0.1, so the refresh cookie can't be `Secure` here.
COOKIE_SECURE=false
