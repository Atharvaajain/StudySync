# StudySync — production environment (server). Set these in the hosting dashboard, never in git.
# The server refuses to start in production with an insecure configuration (see docs/DEPLOYMENT.md).
NODE_ENV=production
HOST=0.0.0.0
# PORT is provided by Render automatically.
LOG_LEVEL=info

# Neon: the DIRECT (non-pooled) connection string, with SSL. Example shape:
# postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&connection_limit=10
DATABASE_URL=

# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Rotating it logs every user out of their access tokens (refresh cookies keep working).
JWT_ACCESS_SECRET=

# Refresh cookie is Secure (HTTPS only). Must stay true in production.
COOKIE_SECURE=true
BCRYPT_COST=12

# Proxies in front of the server: 2 = Vercel rewrite → Render (this guide); 1 = Render only.
TRUST_PROXY=2

# Leave empty when Vercel hosts the web app. Render-only alternative: apps/web/dist.
STATIC_DIR=

# Must NOT be set in production (the server refuses them): ENABLE_TEST_CLOCK, RELAX_RATE_LIMITS,
# ACCESS_TOKEN_TTL_SEC, REFRESH_TOKEN_TTL_DAYS overrides.
