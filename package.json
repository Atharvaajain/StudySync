{
  "name": "studysync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "StudySync \u2014 independent study timers, shared rooms.",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web",
    "e2e"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @studysync/server\" \"npm run dev -w @studysync/web\"",
    "build": "npm run build -w @studysync/web && npm run build -w @studysync/server",
    "start": "npm run start -w @studysync/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @studysync/server",
    "db:reset": "npm run db:reset -w @studysync/server",
    "db:seed": "npm run db:seed -w @studysync/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project web-unit --project server-unit",
    "test:integration": "vitest run --project server-db",
    "test:e2e": "npm run build -w @studysync/web && playwright test -c e2e/playwright.config.ts",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "smoke": "node scripts/smoke.mjs",
    "db:audit": "npm run db:audit -w @studysync/server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
